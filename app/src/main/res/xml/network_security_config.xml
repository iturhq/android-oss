<network-security-config>
    <!--
        Explicit certificate and trust policy, rather than relying implicitly on the platform
        default. No domain-specific overrides here: every flavor except `local` (see
        src/local/res/xml/network_security_config.xml) gets this policy unmodified.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
